            letterLocation[i] = new Sets();
            for (int j = 0; j < solutionWords.length; j++) {
                if (solutionWords[j].getChar(i%5) == (char) (i/5 + 97))
                    letterLocation[i].add(j);
            }
        }
        nonLetterLocation = new Sets[130];
        for (int i = 0; i < nonLetterLocation.length; i++) {
            nonLetterLocation[i] = fullSet(solutionWords.length);
            nonLetterLocation[i] = nonLetterLocation[i].difference(letterLocation[i]);
        }    
        omitted = new Sets[26];
        for (int i = 0; i < omitted.length; i++) {
            omitted[i] = new Sets();
            for (int j = 0; j < solutionWords.length; j++) {
                if (!solutionWords[j].contains((char) (i + 97)))
                    omitted[i].add(j);
            }
        }
        included = new Sets[26];
        for (int i = 0; i < included.length; i++) {
            included[i] = fullSet(solutionWords.length);
            included[i] = included[i].difference(omitted[i]);
        }
        twoTimes = new Sets[26];
        for (int i = 0; i < twoTimes.length; i++) {
            twoTimes[i] = new Sets();
            for (int j = 0; j < solutionWords.length; j++) {
                if (solutionWords[j].twice((char) (i + 97)))
                    twoTimes[i].add(j);
            }
        }
        threeTimes = new Sets[26];
        for (int i = 0; i < threeTimes.length; i++) {
            threeTimes[i] = new Sets();
            for (int j = 0; j < solutionWords.length; j++) {
                if (solutionWords[j].thrice((char) (i + 97)))
                    threeTimes[i].add(j);
            }
        }
    }

    public Sets occurences(WWord guess, WWord answer) {
        Sets s = new Sets();
        byte[] c = guess.colors(answer);
        if (c[0] == 2)
            s = letterLocation[guess.getInt(0)*5];
        else if (c[0] == 1) {
            for (int i = 1; i < 5; i++) {
                    s = s.union(letterLocation[guess.getInt(0)*5 + i]);
            }
        } else if (guess.nums()/10000 == 1)
            s = s.union(omitted[guess.getInt(0)]);
        else {
            for (int i = 0; i < solutionWords.length; i++)
                s.add(i);
        }
        for (int i = 1; i < c.length; i++) {
            if (c[i] == 2)
                s = s.intersection(letterLocation[guess.getInt(i)*5 + i]);
            else if (c[i] == 1) {
                 Sets temp = new Sets();
                for (int j = 0; j < 5; j++) {
                     if (j != i)
                        temp = temp.union(letterLocation[guess.getInt(i)*5 + j]);

                }
                s = s.intersection(temp);
             } else {
                s = s.intersection(omitted[guess.getInt(i)]);
            }
        }
        return s;
    }

    public Sets narrow(Sets og, WWord guess, WWord answer) {
        Sets ng = new Sets();
        for (int i = 0; i < og.getSize(); i++) {
            WWord w = solutionWords[(Integer) og.get(i)];
            if (guess.colors(answer) == guess.colors(answer))
                ng.add(og.get(i));
        }
        return ng;
    }

    public double solve(WWord starting) {
