public ArrayList<String> limitArray(String word){
        ArrayList<String> newList = scan.getAllWordsList();
        WordleWord wordleWord = new WordleWord(word);
        for(int i = 0; i<newList.size();i++){
            byte result[] = wordleWord.color(newList.get(i));
            boolean remove = true;
            for(int f = 0; f<5;f++){
                if(result[f] == 2){
                    remove = false;
                }
            }
            if(remove){
                newList.remove(i);
                i--;
            }
        }
        return newList;
    }  
