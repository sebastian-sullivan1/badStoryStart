public class WWord {
    
    private char [] word;
    
    public WWord(String wd) {
        word = new char[5];
        for (byte i = 0; i < 5; i++)
            word[i] = wd.charAt(i);
    }

    public char getChar(int i) {
        return word[i];
    }

    public int getInt(int i) {
        return ((int) word[i]) - 97;
    }

    public String toString() {
        String str = "";
        for (byte i = 0; i < 5; i++)
            str += word[i];
        return str;
    }

    public boolean contains(char c) {
        for (byte i = 0; i < 5; i++) {
            if (word[i] == c)
                return true;
        }
        return false;
    }

    public boolean contains(char c, int b) {
        return word[b] == c;
    }

    public int Count(char c) {
        int count = 0;
        for (byte i = 0; i < 5; i++) {
            if (word[i] == c)
                count++;
        }
        return count;
    }

    public boolean twice(char c) {
        return Count(c) == 2;
    }

    public boolean thrice(char c) {
        return Count(c) == 3;
    }

    public byte[] colors(WWord answer) {
        byte [] c = new byte[5];
        byte [] g = new byte[5];
        byte [] a = new byte[5];
        for (byte i = 0; i < 5; i++) {
            g[i] = (byte) this.getChar(i);
            a[i] = (byte) answer.getChar(i);
        }
        for (byte i = 0; i < 5; i++) {
            if (g[i] == a[i]) {
                c[i] = 2;
                g[i] = -1;
                a[i] = -2;
            }
        }
        for (byte i = 0; i < 5; i++) {
            for (byte j = 0; j < 5; j++) {
                if (g[i] == a[j]) {
                    c[i] = 1;
                    g[i] = -1;
                    a[j] = -2;
                    j = 5;
                }
            } 
        }
        return c;
    }

    public int nums () { //converts words into numbers for easier comparison
        int i = 11111;
        for (int j = 0; j < 5; j++) {
            for (int k = j+1; k < 5; k++) {
                if (word[j] == word[k]) {
                    i += (int) Math.pow(10, 4-j);
                    i += (int) Math.pow(10, 4-k);
                }
            }
        }
        return i;
    }

    public int[] properties() {
        int [] p = new int[5];
        for (int i = 0; i < 5; i++)
            p[i] = ((int) word[i]) - 97 + i*26;
        return p;
    }

    public int [] basicProperties() {
        int [] p = new int[5];
        for (int i = 0; i < 5; i++)
            p[i] = ((int) word[i]) - 97;
        return p;
    }

    public static void main(String[] args) {
        WWord test1 = new WWord("emcee");
        WWord test2 = new WWord("eerie");
        WWord test3 = new WWord("abaac");
        byte[] sol = test1.colors(test2);
        for (int i = 0; i < sol.length; i++) {
            System.out.print(sol[i]);
        }
        System.out.println();
        System.out.println(test3.nums());
        int[] arr = test3.properties();
        for (int i = 0; i < arr.length; i++)
            System.out.print(arr[i] + ", ");
        int [] arr2 = test3.basicProperties();
        System.out.println();
        for (int i = 0; i < arr2.length; i++)
            System.out.print(arr2[i] + ", ");
    }
}

