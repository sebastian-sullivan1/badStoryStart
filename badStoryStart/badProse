import java.util.ArrayList;
public class WordleWord {
    private char[] word;
    private WordleScan scan;
    public WordleWord(String word){
        this.word = new char[5];
        for(int i = 0; i<5;i++){
            this.word[i] = word.charAt(i);
        }
        this.scan = new WordleScan();
    }
    public WordleWord(){
        this.word = new char[5];
        this.scan = new WordleScan();
    }

    public byte getChar(int index){
        return (byte) word[index];
    }
    
    public byte [] color(String solution){
        byte[] result = new byte[5];
        byte[] solutionArray = new byte[5];
        byte[] guessArray = new byte[5];
        for(byte i = 0; i < 5; i++){
            solutionArray[i] = (byte) solution.charAt(i);
            guessArray[i] = (byte) this.word[i];
        }
        for(byte i = 0; i<5;i++){
            if(guessArray[i] == solutionArray[i]){
                result[i] = 2;
                solutionArray[i] = -1;
            }
        }
        for(byte f = 0; f<5;f++){
                boolean there = false;
                byte track = 0;
                while(! there && track<solutionArray.length){
                    if(solutionArray[track] == guessArray[f]){
                        result[f] = 1;
                        there = true;
                        solutionArray[track] = -1;
                    }
                    track++;
                }
        }
        return result;
    }
    public ArrayList<String> limitArray(String word){
        ArrayList<String> newList = scan.getAllWordsList();
        WordleWord wordleWord = new WordleWord(word);
        for(int i = 0; i<newList.size();i++){
            byte result[] = wordleWord.color(newList.get(i));
            boolean remove = true;
            for(int f = 0; f<5;f++){
                if(result[f] == 2){
                    remove = false;
                }
            }
            if(remove){
                newList.remove(i);
                i--;
            }
        }
        return newList;
    }  
